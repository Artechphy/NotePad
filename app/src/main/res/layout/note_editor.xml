<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingLeft="8dp"
        android:paddingRight="4dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/editor_back"
            style="@style/IconActionButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back_24"
            android:tint="@color/ink"
            android:contentDescription="@string/back_to_notes" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingLeft="4dp"
            android:paddingRight="8dp">

            <TextView
                android:id="@+id/save_status"
                style="@style/BadgeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/status_badge_neutral"
                android:textColor="@color/status_neutral_text"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />
        </FrameLayout>

        <Button
            android:id="@+id/editor_save"
            style="@style/TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginRight="4dp"
            android:text="@string/menu_save" />

        <ImageButton
            android:id="@+id/editor_more"
            style="@style/IconActionButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_more_vert_24"
            android:tint="@color/ink"
            android:contentDescription="@string/more_actions" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp"
            android:focusableInTouchMode="true">

            <EditText
                android:id="@+id/title"
                style="@style/HeadingEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:hint="@string/note_title_hint"
                android:textColorHint="@color/tertiary"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:imeOptions="actionNext" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_label"
                    android:textColor="@color/tertiary"
                    android:textSize="12sp"
                    android:layout_marginRight="10dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/spinner_capsule"
                    android:paddingLeft="6dp"
                    android:paddingRight="4dp"
                    android:gravity="center_vertical">

                    <Spinner
                        android:id="@+id/editor_category"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="108dp"
                        android:contentDescription="@string/category_label" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@color/border_subtle" />

            <EditText
                android:id="@+id/note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="320dp"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:gravity="top"
                android:hint="@string/note_body_hint"
                android:textColorHint="@color/tertiary"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp"
                android:inputType="textMultiLine|textCapSentences"
                android:scrollHorizontally="false" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
