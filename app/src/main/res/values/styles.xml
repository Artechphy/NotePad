<resources>
    <style name="AppTheme" parent="android:style/Theme.Holo.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:colorBackground">@color/page</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="AppDialogTheme" parent="android:style/Theme.Holo.Light.Dialog" />

    <style name="PlainButton">
        <item name="android:background">@drawable/button_plain</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="IconActionButton">
        <item name="android:background">@drawable/button_plain</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="TonalButton">
        <item name="android:background">@drawable/tonal_button</item>
        <item name="android:textColor">@color/on_primary_container</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="CategoryTab" parent="PlainButton">
        <item name="android:background">@drawable/category_tab</item>
        <item name="android:textColor">@color/category_tab_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="FabButton">
        <item name="android:background">@drawable/new_note_background</item>
        <item name="android:scaleType">center</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="HeadingLg">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HeadingEditor">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HeadingCard">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BadgeLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
